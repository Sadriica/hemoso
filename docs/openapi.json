{
  "components": {
    "schemas": {
      "AttentionRow": {
        "description": "The attention.csv row a value crosses (REQ-05).\n\n`attention_level` is the state name Bio 2 writes, which is also the\nsub-heading in `config/content/<indicator_id>.md`; `notify` is who acts;\n`source` is the link or `Assumption` of the row.",
        "properties": {
          "attention_level": {
            "title": "Attention Level",
            "type": "string"
          },
          "notify": {
            "enum": [
              "crew",
              "cmo",
              "flight_surgeon"
            ],
            "title": "Notify",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "attention_level",
          "notify",
          "source"
        ],
        "title": "AttentionRow",
        "type": "object"
      },
      "BloodPressureState": {
        "description": "One blood pressure reading: the worse of its systolic and diastolic state.\n\n`systolic` and `diastolic` are the same body the single-indicator state\nroute returns, one against `bp_sys_mmhg`'s history and one against\n`bp_dia_mmhg`'s; `state` is the worse of the two states\n(`docs/findings/bio2-01-pressure-state-rule.md`).",
        "properties": {
          "diastolic": {
            "$ref": "#/components/schemas/IndicatorState"
          },
          "state": {
            "enum": [
              "no_data",
              "in_range",
              "outside_range",
              "needs_review"
            ],
            "title": "State",
            "type": "string"
          },
          "systolic": {
            "$ref": "#/components/schemas/IndicatorState"
          }
        },
        "required": [
          "state",
          "systolic",
          "diastolic"
        ],
        "title": "BloodPressureState",
        "type": "object"
      },
      "ConditionScore": {
        "description": "The evidence score of one possible condition (bio2-02, REQ-06).\n\n`score` is the mean of the signals' points, from 0 to 1, or null while\nfewer than two signals are usable; `label` is `no_data` with no score.\nThe score is evidence, not a probability: the CMO or the flight surgeon\nconfirms, and the route never says the person has the condition.",
        "properties": {
          "condition_id": {
            "title": "Condition Id",
            "type": "string"
          },
          "label": {
            "enum": [
              "no_data",
              "low",
              "possible",
              "review"
            ],
            "title": "Label",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "signals": {
            "items": {
              "$ref": "#/components/schemas/ConditionSignal"
            },
            "title": "Signals",
            "type": "array"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "condition_id",
          "name",
          "score",
          "label",
          "signals",
          "source"
        ],
        "title": "ConditionScore",
        "type": "object"
      },
      "ConditionSignal": {
        "description": "One signal a condition rests on (bio2-02).\n\n`side` is the side of the person's range that counts for the condition, or\nnull when `based_on` left it out; `contribution` is the point the signal\nadded, or null while it is not usable (no reading, no side or no baseline);\n`value` is the newest reading, or null when there is none.",
        "properties": {
          "contribution": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contribution"
          },
          "indicator_id": {
            "title": "Indicator Id",
            "type": "string"
          },
          "side": {
            "anyOf": [
              {
                "enum": [
                  "above",
                  "below"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Side"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "indicator_id",
          "side",
          "contribution",
          "value"
        ],
        "title": "ConditionSignal",
        "type": "object"
      },
      "Entry": {
        "description": "One row of config/data/demo_data.csv: person, indicator, value, unit, day, time, context.",
        "properties": {
          "context": {
            "default": "rest",
            "enum": [
              "rest",
              "after_exercise",
              "on_waking",
              "before_sleep"
            ],
            "title": "Context",
            "type": "string"
          },
          "indicator_id": {
            "maxLength": 64,
            "title": "Indicator Id",
            "type": "string"
          },
          "mission_day": {
            "exclusiveMinimum": 0.0,
            "maximum": 100000.0,
            "title": "Mission Day",
            "type": "integer"
          },
          "person_id": {
            "maxLength": 64,
            "title": "Person Id",
            "type": "string"
          },
          "time": {
            "title": "Time",
            "type": "string"
          },
          "unit": {
            "maxLength": 64,
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "person_id",
          "indicator_id",
          "value",
          "unit",
          "mission_day",
          "time"
        ],
        "title": "Entry",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IndicatorState": {
        "description": "One value against the person's own baseline (FORMATS.md section 3).\n\n`median` and `spread` are null and `n` counts fewer than 3 entries while\nthe state is `no_data`; `attention` is the row that made the state\n`needs_review`, and null otherwise.",
        "properties": {
          "attention": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AttentionRow"
              },
              {
                "type": "null"
              }
            ]
          },
          "median": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Median"
          },
          "n": {
            "title": "N",
            "type": "integer"
          },
          "spread": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spread"
          },
          "state": {
            "enum": [
              "no_data",
              "in_range",
              "outside_range",
              "needs_review"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "median",
          "spread",
          "n",
          "attention"
        ],
        "title": "IndicatorState",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/entries": {
      "post": {
        "operationId": "create_entry_entries_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Entry"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "An entry with this key and value already existed."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entry"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "An entry with this key already exists with a different value or unit."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Entry"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/people/{person_id}/blood_pressure/state": {
      "get": {
        "description": "One blood pressure reading: the worse of its two states (bio2-01).",
        "operationId": "get_blood_pressure_state_people__person_id__blood_pressure_state_get",
        "parameters": [
          {
            "in": "path",
            "name": "person_id",
            "required": true,
            "schema": {
              "title": "Person Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "systolic",
            "required": true,
            "schema": {
              "title": "Systolic",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "diastolic",
            "required": true,
            "schema": {
              "title": "Diastolic",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "context",
            "required": false,
            "schema": {
              "default": "rest",
              "title": "Context",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "mission_day",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mission Day"
            }
          },
          {
            "in": "query",
            "name": "time",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Time"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BloodPressureState"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "A blood pressure indicator is not in config/data/indicators.csv."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Blood Pressure State"
      }
    },
    "/people/{person_id}/conditions": {
      "get": {
        "description": "The evidence score of every condition in config/rules/conditions.csv.\n\nOne point per signal: 1 when the newest reading crossed an attention row on\nthe signal's side, 0.5 when it is outside the person's baseline on that\nside (both from `app.state`), 0 otherwise; the score is the mean of the\nusable signals (bio2-02, FORMATS.md section 3 point 3).",
        "operationId": "get_conditions_people__person_id__conditions_get",
        "parameters": [
          {
            "in": "path",
            "name": "person_id",
            "required": true,
            "schema": {
              "title": "Person Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConditionScore"
                  },
                  "title": "Response Get Conditions People  Person Id  Conditions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Conditions"
      }
    },
    "/people/{person_id}/indicators/{indicator_id}/history": {
      "get": {
        "operationId": "get_history_people__person_id__indicators__indicator_id__history_get",
        "parameters": [
          {
            "in": "path",
            "name": "person_id",
            "required": true,
            "schema": {
              "title": "Person Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "indicator_id",
            "required": true,
            "schema": {
              "title": "Indicator Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Entry"
                  },
                  "title": "Response Get History People  Person Id  Indicators  Indicator Id  History Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get History"
      }
    },
    "/people/{person_id}/indicators/{indicator_id}/state": {
      "get": {
        "description": "One value against the person's own baseline (FORMATS.md section 3).",
        "operationId": "get_state_people__person_id__indicators__indicator_id__state_get",
        "parameters": [
          {
            "in": "path",
            "name": "person_id",
            "required": true,
            "schema": {
              "title": "Person Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "indicator_id",
            "required": true,
            "schema": {
              "title": "Indicator Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "value",
            "required": true,
            "schema": {
              "title": "Value",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "context",
            "required": false,
            "schema": {
              "default": "rest",
              "title": "Context",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "mission_day",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mission Day"
            }
          },
          {
            "in": "query",
            "name": "time",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Time"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndicatorState"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "The indicator is not in config/data/indicators.csv."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get State"
      }
    }
  }
}
