{
  "components": {
    "schemas": {
      "AccountOut": {
        "description": "The body of `POST /accounts`: the person, nothing else.",
        "properties": {
          "person_id": {
            "title": "Person Id",
            "type": "string"
          }
        },
        "required": [
          "person_id"
        ],
        "title": "AccountOut",
        "type": "object"
      },
      "AttentionRow": {
        "description": "The attention.csv row a value crosses (REQ-05).\n\n`attention_level` is the state name Bio 2 writes, which is also the\nsub-heading in `config/content/<indicator_id>.md`; `notify` is who acts;\n`source` is the link or `Assumption` of the row.",
        "properties": {
          "attention_level": {
            "title": "Attention Level",
            "type": "string"
          },
          "notify": {
            "enum": [
              "crew",
              "cmo",
              "flight_surgeon"
            ],
            "title": "Notify",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "attention_level",
          "notify",
          "source"
        ],
        "title": "AttentionRow",
        "type": "object"
      },
      "BloodPressureState": {
        "description": "One blood pressure reading: the worse of its systolic and diastolic state.\n\n`systolic` and `diastolic` are the same body the single-indicator state\nroute returns, one against `bp_sys_mmhg`'s history and one against\n`bp_dia_mmhg`'s; `state` is the worse of the two states\n(`docs/findings/bio2-01-pressure-state-rule.md`).",
        "properties": {
          "diastolic": {
            "$ref": "#/components/schemas/IndicatorState"
          },
          "state": {
            "enum": [
              "no_data",
              "in_range",
              "outside_range",
              "needs_review"
            ],
            "title": "State",
            "type": "string"
          },
          "systolic": {
            "$ref": "#/components/schemas/IndicatorState"
          }
        },
        "required": [
          "state",
          "systolic",
          "diastolic"
        ],
        "title": "BloodPressureState",
        "type": "object"
      },
      "ConditionScore": {
        "description": "The evidence score of one possible condition (bio2-02, REQ-06, T-79).\n\n`score` is the mean of the signals' points, from 0 to 1, or null while\nfewer than two signals are usable; `label` is `no_data` with no score.\n`red_flag` appears as `true` only when the person reported a symptom that\nthis condition lists and `config/data/symptoms.csv` marks as a red flag; it\nis not a diagnosis and adds no text. The score is evidence, not a\nprobability: the CMO or the flight surgeon confirms, and the route never\nsays the person has the condition.",
        "properties": {
          "condition_id": {
            "title": "Condition Id",
            "type": "string"
          },
          "label": {
            "enum": [
              "no_data",
              "low",
              "possible",
              "review"
            ],
            "title": "Label",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "red_flag": {
            "default": false,
            "title": "Red Flag",
            "type": "boolean"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "signals": {
            "items": {
              "$ref": "#/components/schemas/ConditionSignal"
            },
            "title": "Signals",
            "type": "array"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "condition_id",
          "name",
          "score",
          "label",
          "signals",
          "source"
        ],
        "title": "ConditionScore",
        "type": "object"
      },
      "ConditionSignal": {
        "description": "One signal a condition rests on (bio2-02, T-79).\n\n`kind` is `indicator` for a measured signal and `symptom` for one the\nperson reported; a symptom signal carries `symptom_id` and a point of its\nown, and the indicator fields stay empty. `side` is the side of the\nperson's range that counts for the condition, or null when `based_on` left\nit out; `contribution` is the point the signal added, or null while it is\nnot usable (no reading, no side, no baseline, or a symptom not reported);\n`value` is the newest reading, or null when there is none.\n\nThe route leaves out the fields a signal does not set\n(`response_model_exclude_unset`), so an indicator signal keeps the four\nfields it had before the symptom layer and a symptom signal adds `kind` and\n`symptom_id`.",
        "properties": {
          "contribution": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contribution"
          },
          "indicator_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Indicator Id"
          },
          "kind": {
            "default": "indicator",
            "enum": [
              "indicator",
              "symptom"
            ],
            "title": "Kind",
            "type": "string"
          },
          "side": {
            "anyOf": [
              {
                "enum": [
                  "above",
                  "below"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Side"
          },
          "symptom_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symptom Id"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "title": "ConditionSignal",
        "type": "object"
      },
      "Credentials": {
        "description": "The body of `POST /accounts` and of `POST /sessions`.\n\n`person_id` follows the same lowercase `snake_case` rule as every id in the\nAPI; `pin` is 4 to 8 digits.",
        "properties": {
          "person_id": {
            "maxLength": 64,
            "title": "Person Id",
            "type": "string"
          },
          "pin": {
            "maxLength": 8,
            "title": "Pin",
            "type": "string"
          }
        },
        "required": [
          "person_id",
          "pin"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "Entry": {
        "description": "One row of config/data/demo_data.csv: person, indicator, value, unit, day, time, context.",
        "properties": {
          "context": {
            "default": "rest",
            "enum": [
              "rest",
              "after_exercise",
              "on_waking",
              "before_sleep"
            ],
            "title": "Context",
            "type": "string"
          },
          "indicator_id": {
            "maxLength": 64,
            "title": "Indicator Id",
            "type": "string"
          },
          "mission_day": {
            "exclusiveMinimum": 0.0,
            "maximum": 100000.0,
            "title": "Mission Day",
            "type": "integer"
          },
          "person_id": {
            "maxLength": 64,
            "title": "Person Id",
            "type": "string"
          },
          "time": {
            "title": "Time",
            "type": "string"
          },
          "unit": {
            "maxLength": 64,
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "person_id",
          "indicator_id",
          "value",
          "unit",
          "mission_day",
          "time"
        ],
        "title": "Entry",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IndicatorState": {
        "description": "One value against the person's own baseline (FORMATS.md section 3).\n\n`median` and `spread` are null and `n` counts fewer than 3 entries while\nthe state is `no_data`; `attention` is the row that made the state\n`needs_review`, and null otherwise.",
        "properties": {
          "attention": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AttentionRow"
              },
              {
                "type": "null"
              }
            ]
          },
          "median": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Median"
          },
          "n": {
            "title": "N",
            "type": "integer"
          },
          "spread": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spread"
          },
          "state": {
            "enum": [
              "no_data",
              "in_range",
              "outside_range",
              "needs_review"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "median",
          "spread",
          "n",
          "attention"
        ],
        "title": "IndicatorState",
        "type": "object"
      },
      "PainReport": {
        "description": "One stored pain report: the fields above and whose report it is.",
        "properties": {
          "intensity": {
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Intensity",
            "type": "integer"
          },
          "mission_day": {
            "exclusiveMinimum": 0.0,
            "maximum": 100000.0,
            "title": "Mission Day",
            "type": "integer"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 280,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "person_id": {
            "maxLength": 64,
            "title": "Person Id",
            "type": "string"
          },
          "region_id": {
            "maxLength": 64,
            "title": "Region Id",
            "type": "string"
          },
          "time": {
            "title": "Time",
            "type": "string"
          }
        },
        "required": [
          "region_id",
          "intensity",
          "mission_day",
          "time",
          "person_id"
        ],
        "title": "PainReport",
        "type": "object"
      },
      "PainReportIn": {
        "description": "The body of `POST /people/{person_id}/pain`: the person is in the path.",
        "properties": {
          "intensity": {
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Intensity",
            "type": "integer"
          },
          "mission_day": {
            "exclusiveMinimum": 0.0,
            "maximum": 100000.0,
            "title": "Mission Day",
            "type": "integer"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 280,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "region_id": {
            "maxLength": 64,
            "title": "Region Id",
            "type": "string"
          },
          "time": {
            "title": "Time",
            "type": "string"
          }
        },
        "required": [
          "region_id",
          "intensity",
          "mission_day",
          "time"
        ],
        "title": "PainReportIn",
        "type": "object"
      },
      "SessionOut": {
        "description": "The body of `POST /sessions`: the token and when it stops working.\n\n`expires_at` is ISO 8601 in UTC; the token is sent as\n`Authorization: Bearer <token>`.",
        "properties": {
          "expires_at": {
            "title": "Expires At",
            "type": "string"
          },
          "person_id": {
            "title": "Person Id",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "person_id",
          "expires_at"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "SymptomReport": {
        "description": "One stored symptom report: the fields above and whose report it is.",
        "properties": {
          "mission_day": {
            "exclusiveMinimum": 0.0,
            "maximum": 100000.0,
            "title": "Mission Day",
            "type": "integer"
          },
          "person_id": {
            "maxLength": 64,
            "title": "Person Id",
            "type": "string"
          },
          "severity": {
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Severity",
            "type": "integer"
          },
          "symptom_id": {
            "maxLength": 64,
            "title": "Symptom Id",
            "type": "string"
          },
          "time": {
            "title": "Time",
            "type": "string"
          }
        },
        "required": [
          "symptom_id",
          "severity",
          "mission_day",
          "time",
          "person_id"
        ],
        "title": "SymptomReport",
        "type": "object"
      },
      "SymptomReportIn": {
        "description": "The body of `POST /people/{person_id}/symptoms`: the person is in the path.",
        "properties": {
          "mission_day": {
            "exclusiveMinimum": 0.0,
            "maximum": 100000.0,
            "title": "Mission Day",
            "type": "integer"
          },
          "severity": {
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Severity",
            "type": "integer"
          },
          "symptom_id": {
            "maxLength": 64,
            "title": "Symptom Id",
            "type": "string"
          },
          "time": {
            "title": "Time",
            "type": "string"
          }
        },
        "required": [
          "symptom_id",
          "severity",
          "mission_day",
          "time"
        ],
        "title": "SymptomReportIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/accounts": {
      "post": {
        "description": "Create one account (REQ-37): the PIN is kept only as a salted hash.",
        "operationId": "create_account_accounts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "This username is taken, or this person already has an account."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Account"
      }
    },
    "/entries": {
      "post": {
        "operationId": "create_entry_entries_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Entry"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "An entry with this key and value already existed."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entry"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "An entry with this key already exists with a different value or unit."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Entry"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/people/{person_id}/blood_pressure/state": {
      "get": {
        "description": "One blood pressure reading: the worse of its two states (bio2-01).",
        "operationId": "get_blood_pressure_state_people__person_id__blood_pressure_state_get",
        "parameters": [
          {
            "in": "path",
            "name": "person_id",
            "required": true,
            "schema": {
              "title": "Person Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "systolic",
            "required": true,
            "schema": {
              "title": "Systolic",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "diastolic",
            "required": true,
            "schema": {
              "title": "Diastolic",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "context",
            "required": false,
            "schema": {
              "default": "rest",
              "title": "Context",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "mission_day",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mission Day"
            }
          },
          {
            "in": "query",
            "name": "time",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Time"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BloodPressureState"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "A blood pressure indicator is not in config/data/indicators.csv."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Blood Pressure State"
      }
    },
    "/people/{person_id}/conditions": {
      "get": {
        "description": "The evidence score of every condition in config/rules/conditions.csv.\n\nOne point per signal: 1 when the newest reading crossed an attention row on\nthe signal's side, 0.5 when it is outside the person's baseline on that\nside (both from `app.state`), 0 otherwise; the score is the mean of the\nusable signals (bio2-02, FORMATS.md section 3 point 3). A reported symptom\nthat a row lists in its optional `symptoms` column is one more usable\nsignal (T-79): 0.5 when only that row lists it, 0.25 when two or more do.\n\nFields a condition leaves unset are left out of the answer, so a\nfour-column `conditions.csv` returns exactly the body it returned before\nthe symptom layer: no `kind` on an indicator signal, no `red_flag`.",
        "operationId": "get_conditions_people__person_id__conditions_get",
        "parameters": [
          {
            "in": "path",
            "name": "person_id",
            "required": true,
            "schema": {
              "title": "Person Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConditionScore"
                  },
                  "title": "Response Get Conditions People  Person Id  Conditions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Conditions"
      }
    },
    "/people/{person_id}/indicators/{indicator_id}/history": {
      "get": {
        "operationId": "get_history_people__person_id__indicators__indicator_id__history_get",
        "parameters": [
          {
            "in": "path",
            "name": "person_id",
            "required": true,
            "schema": {
              "title": "Person Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "indicator_id",
            "required": true,
            "schema": {
              "title": "Indicator Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Entry"
                  },
                  "title": "Response Get History People  Person Id  Indicators  Indicator Id  History Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get History"
      }
    },
    "/people/{person_id}/indicators/{indicator_id}/state": {
      "get": {
        "description": "One value against the person's own baseline (FORMATS.md section 3).",
        "operationId": "get_state_people__person_id__indicators__indicator_id__state_get",
        "parameters": [
          {
            "in": "path",
            "name": "person_id",
            "required": true,
            "schema": {
              "title": "Person Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "indicator_id",
            "required": true,
            "schema": {
              "title": "Indicator Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "value",
            "required": true,
            "schema": {
              "title": "Value",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "context",
            "required": false,
            "schema": {
              "default": "rest",
              "title": "Context",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "mission_day",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
